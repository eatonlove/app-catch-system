# Replace domain, certificates and port only after confirming this project's values.
server {
 listen 443 ssl;
 server_name REPLACE_DOMAIN;
 ssl_certificate REPLACE_CERT;
 ssl_certificate_key REPLACE_KEY;
 client_max_body_size 4m;
 location / {
  proxy_pass http://127.0.0.1:REPLACE_PORT;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_read_timeout 120s;
 }
}
